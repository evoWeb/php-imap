{
	"name": "evoweb/php-imap",
	"description": "Manage mailboxes, filter/get/delete emails in PHP (supports IMAP/POP3/NNTP)",
	"keywords": [
		"PHP",
		"mail",
		"IMAP",
		"POP3",
		"mailbox",
		"receive emails"
	],
	"homepage": "https://github.com/barbushin/php-imap",
	"license": "MIT",
	"type": "library",
	"authors": [
		{
			"name": "Sergey Barbushin",
			"homepage": "https://linkedin.com/in/barbushin",
			"email": "barbushin@gmail.com"
		},
		{
			"name": "Sebastian Fischer",
			"homepage": "https://github.com/garbast",
			"email": "php-imap@fischer.im"
		}
	],
	"config": {
		"sort-packages": true
	},
	"require": {
		"php": "^8.2",
		"ext-fileinfo": "*",
		"ext-iconv": "*",
		"ext-imap": "*",
		"ext-mbstring": "*",
		"ext-json": "*",
		"ext-random": "*"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.4",
		"maglnet/composer-require-checker": "^4.15.0",
		"paragonie/hidden-string": "^2.0",
		"phpstan/phpstan": "^2.1.43",
		"phpstan/phpstan-phpunit": "^2.0.8",
		"phpunit/phpunit": "^11.5.55",
		"povils/phpmnd": "^3.6.1",
		"roave/security-advisories": "dev-latest",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"scripts": {
		"php-cs-fixer-check": "php-cs-fixer check -v --diff --config=Build/php-cs-fixer/config.php",
		"php-cs-fixer-fix": "php-cs-fixer fix --no-interaction -v --config=Build/php-cs-fixer/config.php",
		"phpmd": "phpmnd ./ --exclude=./.ddev/ --exclude=./.github/ --exclude=./examples/ --exclude=./vendor/ --hint",
		"composer-require-checker": "composer-require-checker check --config-file=Build/composer-require-checker/config.json composer.json",
		"phpcs": "phpcs --standard=Build/phpcs/phpcs.xml examples src tests",
		"phpstan": "phpstan analyse --configuration Build/phpstan/phpstan.neon",
		"phpunit": "phpunit --no-coverage --configuration Build/phpunit/UnitTests.xml",
		"phpunit-coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover .cache/clover.xml --configuration Build/phpunit/UnitTests.xml",
		"static-analysis": [
			"@php-cs-fixer-check",
			"@composer-require-checker",
			"@phpmd",
			"@php-cs-fixer-fix",
			"@phpstan"
		],
		"tests": [
			"@static-analysis",
			"@phpunit"
		]
	},
	"suggest": {
		"ext-fileinfo": "To facilitate IncomingMailAttachment::getFileInfo() auto-detection"
	},
	"autoload-dev": {
		"psr-4": {
			"PhpImap\\Tests\\": "tests"
		}
	},
	"autoload": {
		"psr-4": {
			"PhpImap\\": "src/PhpImap"
		}
	}
}
