<?xml version="1.0"?>
<ruleset name="php-imap">
    <!-- Base standard: PSR-12 (@PSR12) -->
    <rule ref="PSR12">
        <!-- single_line_empty_body: allow empty function/method bodies on one line -->
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
        <!-- single_line_empty_body: allow empty class bodies on one line -->
        <exclude name="PSR2.Classes.ClassDeclaration.OpenBraceNewLine"/>
    </rule>

    <!-- Line length: warning at 120 chars, no hard error (absoluteLineLimit=0) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- array_syntax: short -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- array_indentation -->
    <rule ref="Generic.Arrays.ArrayIndent"/>

    <!-- cast_spaces: none -->
    <rule ref="Generic.Formatting.SpaceAfterCast">
        <properties>
            <property name="spacing" value="0"/>
        </properties>
    </rule>

    <!-- native_function_casing -->
    <rule ref="Squiz.PHP.LowercasePHPFunctions"/>

    <!-- no_empty_statement -->
    <rule ref="Generic.CodeAnalysis.EmptyStatement">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Allow underscore method names for deprecated fallback methods -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*.php</exclude-pattern>
    </rule>
</ruleset>