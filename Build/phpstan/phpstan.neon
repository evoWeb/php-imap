includes:
  - ../../Build/phpstan/phpstan-baseline.neon
  - ../../vendor/phpstan/phpstan-phpunit/extension.neon
  - ../../vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
  # Use local .cache dir instead of /tmp
  tmpDir: ../../.cache/phpstan

  level: 5

  bootstrapFiles:
    - phpstan-constants.php

  paths:
    - ../../examples
    - ../../src
    - ../../tests

  # In 2026, this option does not help that much any more since our code base is moving to PHP 8
  # and native PHP types. It certainly does not hurt to re-check this every once in a while to
  # see what would happen if we set this option to "true" again.
  # treatPhpDocTypesAsCertain is explicitly disabled because we MUST not trust doc types 100%.
  treatPhpDocTypesAsCertain: false

  ignoreErrors:
    # imap_close() returns bool in PHP <8.4 and void since PHP 8.4
    - identifier: booleanNot.alwaysFalse
      path: ../../src/PhpImap/Imap.php
      reportUnmatched: false
